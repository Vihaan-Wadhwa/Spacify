{
  "$jsonSchema": {
    "title": "room_designs: one document per PostgreSQL room (rooms.id)",
    "bsonType": "object",
    "required": ["room_id", "project_id", "room_type", "walls", "flooring", "updated_by", "updated_at"],
    "additionalProperties": false,
    "properties": {
      "_id": { "bsonType": "objectId" },
      "room_id": { "bsonType": "int", "minimum": 1, "description": "PostgreSQL rooms.id (unique index)" },
      "project_id": { "bsonType": "int", "minimum": 1, "description": "PostgreSQL projects.id (index)" },
      "room_type": { "bsonType": "string", "minLength": 1, "maxLength": 50, "description": "copy of rooms.room_type" },
      "walls": {
        "bsonType": "object",
        "required": ["finish", "color"],
        "additionalProperties": false,
        "properties": {
          "finish": { "enum": ["paint", "tiles", "marble", "wallpaper", "wood_panel"] },
          "color": { "bsonType": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "name": { "bsonType": "string", "minLength": 1, "maxLength": 50, "description": "marble / wallpaper design or paint shade" }
        }
      },
      "flooring": {
        "bsonType": "object",
        "required": ["material", "name", "color"],
        "additionalProperties": false,
        "properties": {
          "material": { "enum": ["marble", "vitrified", "tiles", "wood", "granite"] },
          "name": { "bsonType": "string", "minLength": 1, "maxLength": 50 },
          "color": { "bsonType": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      },
      "windows": {
        "bsonType": "object",
        "required": ["type", "frame", "color", "polish"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["sliding", "casement", "fixed", "mesh"] },
          "frame": { "enum": ["aluminium", "wood"] },
          "color": { "bsonType": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "polish": { "enum": ["matte", "satin", "gloss"] }
        }
      },
      "doors": {
        "bsonType": "object",
        "required": ["style", "color", "polish"],
        "additionalProperties": false,
        "properties": {
          "style": { "enum": ["flush", "panelled", "grooved", "glass"] },
          "color": { "bsonType": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "polish": { "enum": ["matte", "satin", "gloss"] }
        }
      },
      "furniture": {
        "bsonType": "array",
        "maxItems": 40,
        "items": {
          "bsonType": "object",
          "required": ["id", "type", "x", "z", "rot"],
          "additionalProperties": false,
          "properties": {
            "id": { "bsonType": "int", "minimum": 1 },
            "type": {
              "enum": [
                "bed_single", "bed_double", "bed_queen", "bed_king", "bedside_table", "cupboard",
                "dressing_table", "study_table", "tv_panel", "sofa", "dining_table"
              ]
            },
            "x": { "bsonType": ["double", "int"], "minimum": 0, "maximum": 100, "description": "feet from the room's west wall to the item's centre" },
            "z": { "bsonType": ["double", "int"], "minimum": 0, "maximum": 100, "description": "feet from the room's north wall" },
            "rot": { "enum": [0, 90, 180, 270] }
          }
        }
      },
      "ceiling": {
        "bsonType": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["plain", "pop", "gypsum", "wood"] }
        }
      },
      "lighting": {
        "bsonType": "array",
        "maxItems": 10,
        "items": {
          "bsonType": "object",
          "required": ["type", "count"],
          "additionalProperties": false,
          "properties": {
            "type": { "bsonType": "string", "minLength": 1, "maxLength": 40 },
            "count": { "bsonType": "int", "minimum": 1, "maximum": 50 }
          }
        }
      },
      "kitchen": {
        "bsonType": "object",
        "required": ["layout", "countertop"],
        "additionalProperties": false,
        "description": "kitchens only; present = modular kitchen",
        "properties": {
          "layout": { "enum": ["L", "U", "parallel", "island", "straight"] },
          "countertop": { "bsonType": "string", "minLength": 1, "maxLength": 50 }
        }
      },
      "updated_by": { "bsonType": "int", "minimum": 1, "description": "PostgreSQL users.id" },
      "updated_at": { "bsonType": "date" }
    }
  }
}
