# Copy to .env.local and fill in. Never commit .env.local.

# PostgreSQL. This matches docker-compose.yml; change it if your Postgres uses another user/password/port.
DATABASE_URL=postgres://spacify:spacify@localhost:5432/spacify

# MongoDB, for room designs (wall finish, flooring, ceiling, lighting). This matches docker-compose.yml.
# For MongoDB Atlas, paste its mongodb+srv://… connection string instead.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=spacify

# Which model reads floor-plan sketches: "gemini" (Gemini API) or "n8n" (hosted workflow).
SKETCH_PROVIDER=gemini

# Gemini API key for reading sketches. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: another Gemini vision model.
GEMINI_VISION_MODEL=gemini-3.5-flash

# Optional local text model (Ollama) that suggests layouts on /start. Without it, the rule-based plans still work.
OLLAMA_URL=http://localhost:11434

# Only used when SKETCH_PROVIDER=n8n (image → Gemini → rooms JSON).
N8N_SKETCH_WEBHOOK_URL=https://YOUR-N8N-INSTANCE/webhook/analyse-floorplan

# n8n workflow for the AI assistant. Leave empty to use the built-in canned answers.
N8N_CHAT_WEBHOOK_URL=
