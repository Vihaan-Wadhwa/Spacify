# Copy to .env.local and fill in. Never commit .env.local.

# n8n workflow that reads a floor-plan sketch (image → Gemini → rooms JSON).
# The browser never sees this URL — /api/sketch calls it from the server.
N8N_SKETCH_WEBHOOK_URL=https://vihu14.app.n8n.cloud/webhook/analyse-floorplan

# n8n workflow for the AI assistant. Leave empty to use the built-in canned answers.
N8N_CHAT_WEBHOOK_URL=
